{
  "expo": {
    "name": "Hôm nay ăn gì",
    "slug": "hom-nay-an-gi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "homnayangi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.homnayangi.app"
    },
    "android": {
      "package": "com.homnayangi.app",
      "adaptiveIcon": {
        "backgroundColor": "#D9F8EE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7FFFC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#0E1A17"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cho phép Hôm nay ăn gì dùng vị trí để gợi ý món theo thời tiết và tìm quán gần bạn."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép Hôm nay ăn gì truy cập thư viện ảnh để đăng ảnh, video món ăn.",
          "cameraPermission": "Cho phép Hôm nay ăn gì dùng camera để chụp ảnh món ăn.",
          "microphonePermission": false
        }
      ],
      "expo-video",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
