{
  "expo": {
    "name": "Hôm nay ăn gì",
    "slug": "hom-nay-an-gi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "homnayangi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cho phép Hôm nay ăn gì dùng vị trí để gợi ý quán ăn gần bạn."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép Hôm nay ăn gì truy cập thư viện ảnh để chọn ảnh món ăn.",
          "cameraPermission": "Cho phép Hôm nay ăn gì dùng camera để chụp ảnh món ăn.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
