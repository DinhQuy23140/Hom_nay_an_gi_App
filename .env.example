# Sao chép file này thành `.env` rồi điền giá trị thật.

# Firebase — Project settings → Your apps → Web app config
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In — OAuth client ID loại "Web application" (Firebase → Authentication → Google)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Chỉ cần khi build iOS: reversed iOS client ID, dạng com.googleusercontent.apps.xxxx
GOOGLE_IOS_URL_SCHEME=

# Supabase — Project settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_BUCKET=media
